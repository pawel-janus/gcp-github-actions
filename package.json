{
  "name": "gcp-github-actions",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo demonstrating CI/CD with GitHub Actions and Workload Identity Federation for multi-service GCP deployments",
  "workspaces": [
    "workspaces/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "build:backend": "npm run build --workspace=backend",
    "start:backend": "npm run start --workspace=backend"
  },
  "keywords": [
    "gcp",
    "github-actions",
    "workload-identity-federation",
    "cloud-run",
    "monorepo"
  ],
  "author": "Paweł Janus <paweljanus.dev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
